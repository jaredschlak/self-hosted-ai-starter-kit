# Example local environment configuration for self-hosted AI starter kit.
# Copy this file to .env and replace placeholder values before running locally.
# Do not commit your real .env file.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_USER_MANAGEMENT_JWT_SECRET=replace-with-a-long-random-string
